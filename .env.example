# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database & broker ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobalert
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/jobalert
REDIS_URL=redis://redis:6379/0
# Loopback ports published for tests and DB tools. Change them when another Postgres or
# Redis already uses 5432/6379 on this machine. Tests then need TEST_DATABASE_URL, e.g.
# postgresql://postgres:change-me@127.0.0.1:55432/jobalert_test
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- API ---
# Back-office endpoints (/v1/internal) need this in X-API-Key; empty = disabled
INTERNAL_API_KEY=
# Signs sign-in codes and email links; empty = sign-in disabled
APP_SECRET=
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_PER_MINUTE=120
# SESSION_DAYS=60
# API_WORKERS=2

# --- Notifications ---
# Web Push key pair, generated once: cd apps/notifier && uv run python vapid.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Local: Mailpit (http://localhost:8025). Production: your provider's SMTP relay,
# e.g. SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_SECURITY=starttls + user/password
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=LastBell <no-reply@lastbell.local>
# EMAIL_REPLY_TO=
# Links in emails and pushes
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# NOTIFY_CONCURRENCY=8
# DELIVER_RATE_LIMIT=20/s

# --- Scraper ---
# Optional VLM OCR for stylized image adverts (deAPI); empty = Tesseract only
DEAPI_API_KEY=
# WORKER_CONCURRENCY=4
# NTS_SCRAPE_HOUR=6

# --- Monitoring ---
FLOWER_BASIC_AUTH=admin:change-me
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Website revalidation (scraper outbox -> Next.js POST /api/revalidate) ---
# Empty = skipped (local dev without the web app)
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=

# --- Heartbeats (Healthchecks.io ping URLs; empty = no ping) ---
# One check per job: scrape (daily), outbox (every minute), reminders (daily)
HEALTHCHECK_URL_SCRAPE=
HEALTHCHECK_URL_OUTBOX=
HEALTHCHECK_URL_REMINDERS=
