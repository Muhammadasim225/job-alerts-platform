# Store and check out text files with LF everywhere (Linux containers, servers, CI).
# Without this, Windows checkouts get CRLF and shell scripts break inside Docker.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
Dockerfile text eol=lf

# Windows-only scripts keep CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary fixtures and assets: never touch
*.docx  binary
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
